# --- Supabase ---
# Found in Supabase dashboard: Project Settings -> Data API / API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API Keys -> service_role (secret, backend only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> Data API -> JWT Settings -> JWT Secret (used to verify user tokens)
SUPABASE_JWT_SECRET=

# --- LLM provider (Phase 4+, not used yet in Phase 1) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
